# Backend environment configuration.
# Copy to .env and adjust for your database.
# The docker-compose file supplies DATABASE_URL automatically for local runs.

# PostgreSQL connection string used by Prisma (pooled).
DATABASE_URL=postgresql://postgres:password@localhost:5432/kspdb?schema=public

# Direct PostgreSQL connection used for migrations (same URL locally).
DIRECT_URL=postgresql://postgres:password@localhost:5432/kspdb?schema=public

# API port (default 3000).
PORT=3000

# Minutes of heartbeat silence before a pole is treated as possibly dark.
# Firmware 1.2 devices never send power_lost; 15 min matches the
# 15-minute heartbeat cadence.
HEARTBEAT_TIMEOUT_MINUTES=15

# Node environment.
NODE_ENV=development
